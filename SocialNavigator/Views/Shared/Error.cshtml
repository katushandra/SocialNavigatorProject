@{
    ViewData["Title"] = "Ошибка";
}

<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <div class="bg-white p-5 rounded shadow">
                    <div class="mb-4">
                        <i class="fi fi-close-circle fs-1 text-danger"></i>
                    </div>
                    <h1 class="display-4 fw-bold mb-4">Ошибка</h1>
                    <p class="lead mb-4">Произошла ошибка при обработке вашего запроса.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-pill">
                        На главную
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>