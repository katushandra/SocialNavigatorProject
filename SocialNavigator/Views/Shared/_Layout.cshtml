﻿@using Microsoft.AspNetCore.Identity
@using Domain.Entity
@using Domain.Entity.Enums
@using Application.Common.Interfaces
@using Microsoft.EntityFrameworkCore
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject ILocalDbContext Context
@{
    var user = await UserManager.GetUserAsync(User);
    var userFullName = user?.FullName ?? user?.UserName;

    int pendingCount = 0;
    if (user != null && (User.IsInRole("Moderator") || User.IsInRole("Admin")))
    {
        pendingCount = await Context.SocialObject
            .CountAsync(x => x.Status == Status.Pending);
    }
}

<!doctype html>
<html lang="ru" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <title>@(ViewData["Title"] ?? "Социальный навигатор")</title>
    <meta name="description" content="Карта доступности">

    <meta name="viewport" content="width=device-width, maximum-scale=5, initial-scale=1">
    <!--[if IE]><meta http-equiv='X-UA-Compatible' content='IE=edge,chrome=1'><![endif]-->
    <!-- up to 10% speed up for external res -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com/">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com/">
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/">
    <!-- preloading icon font is helping to speed up a little bit -->
    <link rel="preload" href="~/frontend/assets/fonts/flaticon/Flaticon.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="~/frontend/assets/css/core.min.css">
    <link rel="stylesheet" href="~/frontend/assets/css/vendor_bundle.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- favicon -->
    <link rel="shortcut icon" href="~/frontend/favicon.ico">
    <link rel="apple-touch-icon" href="~/frontend/demo.files/logo/icon_512x512.png">

    <!-- Адаптация под мобильные устройства-->
    <style>
        @@media (max-width: 768px) {
            /* Уменьшаем отступы */
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }

            .card-body {
                padding: 1rem !important;
            }

            .p-4, .p-5 {
                padding: 1rem !important;
            }

            .py-5, .py-6, .py-7 {
                padding-top: 1.5rem !important;
                padding-bottom: 1.5rem !important;
            }
            /* Заголовки */
            h1.display-4, .display-4 {
                font-size: 1.8rem;
            }

            h1.display-5, .display-5 {
                font-size: 1.5rem;
            }
            /* Формы - кнопки на всю ширину */
            .row > .col-md-6.mt-4 {
                width: 100%;
            }
            /* Таблицы - горизонтальный скролл */
            .table-responsive {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            /* Карточки объектов - единые отступы */
            .card.mb-3, .card.mb-4 {
                margin-bottom: 1rem !important;
            }
            /* Карточки с d-flex - не центрируем */
            .card-body.d-flex {
                flex-direction: column;
                align-items: flex-start !important;
            }

                .card-body.d-flex .ms-4 {
                    margin-left: 0 !important;
                    margin-top: 1rem;
                    align-self: flex-start;
                }
            /* Карта */
            #map {
                height: 300px !important;
            }
            /* Навигация по статусам */
            .nav.nav-lg {
                flex-wrap: wrap;
                gap: 0.5rem;
            }

                .nav.nav-lg .nav-link {
                    padding: 0.4rem 0.8rem;
                    font-size: 0.85rem;
                }
            /* Модальные окна */
            .modal-dialog {
                margin: 0.5rem;
            }
            /* Шаги в Add.cshtml */
            .step-connector {
                display: none;
            }

            .d-flex.justify-content-between.align-items-center {
                flex-wrap: wrap;
                gap: 0.5rem;
            }
            /* Фильтры */
            .row.g-3 > [class*="col-"] {
                margin-bottom: 0.5rem;
            }
            /* Кнопка "Найти" по центру */
            .filter-button-wrapper {
                text-align: center;
            }
            /* Кнопки в AdminPanel вертикально */
            .admin-actions .col {
                width: 100%;
                margin-bottom: 0.75rem;
            }
            /* Выпадающие списки на мобильных */
            select.form-select,
            select.form-select-lg {
                font-size: 16px !important;
                padding: 0.75rem 2rem 0.75rem 0.75rem !important;
                width: 100%;
                max-width: 100%;
                white-space: normal;
                word-break: normal;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            /* Контейнер для select на мобильных */
            .form-floating select.form-select {
                min-height: 58px;
            }
            /* Кнопка "Добавить объект" - только иконка на мобильных */
            .btn-add-object-mobile .btn-text {
                display: none;
            }

            .btn-add-object-mobile .fi-plus {
                margin-right: 0 !important;
            }

            .btn-add-object-mobile {
                padding-left: 0.75rem !important;
                padding-right: 0.75rem !important;
            }
        }

        @@media (max-width: 576px) {
            /* Еще меньше отступов */
            .px-5 {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }
            /* Скрываем некоторые элементы на очень маленьких экранах */
            .badge-group {
                flex-wrap: wrap;
            }
            /* Текст в карточках */
            .card-title {
                font-size: 1.1rem;
            }
            /* Статистика на админ-панели */
            .col-xl-3.col-md-6 {
                margin-bottom: 0.75rem;
            }
        }

        /* Стиль для кнопки добавления объекта - адаптивный */
        .btn-add-object-responsive .btn-text {
            display: inline;
        }

        @@media (max-width: 576px) {
            .btn-add-object-responsive .btn-text {
                display: none;
            }

            .btn-add-object-responsive .fi-plus {
                margin-right: 0 !important;
            }

            .btn-add-object-responsive {
                padding-left: 0.65rem !important;
                padding-right: 0.65rem !important;
            }
        }
    </style>
    @RenderSection("css", required: false)
</head>

<body data-s2t-class="btn-primary bg-gradient" data-bs-spy="scroll" data-bs-target="#demos-scrollspy" data-bs-offset="0">

    <!-- Header -->
    <header id="header">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary bg-gradient text-white justify-content-lg-between justify-content-md-inherit px-3">

            <div class="align-items-start float-start">

                <!-- mobile menu button : show -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainColor" aria-controls="navbarMainColor" aria-expanded="false" aria-label="Toggle navigation">
                    <svg fill="#fff" width="25" viewBox="0 0 20 20">
                        <path d="M 19.9876 1.998 L -0.0108 1.998 L -0.0108 -0.0019 L 19.9876 -0.0019 L 19.9876 1.998 Z"></path>
                        <path d="M 19.9876 7.9979 L -0.0108 7.9979 L -0.0108 5.9979 L 19.9876 5.9979 L 19.9876 7.9979 Z"></path>
                        <path d="M 19.9876 13.9977 L -0.0108 13.9977 L -0.0108 11.9978 L 19.9876 11.9978 L 19.9876 13.9977 Z"></path>
                        <path d="M 19.9876 19.9976 L -0.0108 19.9976 L -0.0108 17.9976 L 19.9876 17.9976 L 19.9876 19.9976 Z"></path>
                    </svg>
                </button>

                <!-- navbar : brand (logo) -->
                <a class="navbar-brand" href="/">
                    <img src="~/frontend/assets/images/logo/logo_white.svg" alt="Social Navigator">
                </a>

            </div>

            <!-- Menu -->
            <div class="collapse navbar-collapse" id="navbarMainColor">

                <!-- navbar : mobile menu -->
                <div class="navbar-xs d-none">

                    <!-- mobile menu button : close -->
                    <button class="navbar-toggler pt-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainColor" aria-controls="navbarMainColor" aria-expanded="false" aria-label="Toggle navigation">
                        <svg width="20" viewBox="0 0 20 20">
                            <path d="M 20.7895 0.977 L 19.3752 -0.4364 L 10.081 8.8522 L 0.7869 -0.4364 L -0.6274 0.977 L 8.6668 10.2656 L -0.6274 19.5542 L 0.7869 20.9676 L 10.081 11.679 L 19.3752 20.9676 L 20.7895 19.5542 L 11.4953 10.2656 L 20.7895 0.977 Z"></path>
                        </svg>
                    </button>

                    <!-- navbar : brand (logo) : mobile -->
                    <a class="navbar-brand" href="/">
                        <img src="~/frontend/assets/images/logo/logo_white.svg" alt="Social Navigator">
                    </a>

                </div>
                <!-- /navbar : mobile menu -->
                <!-- navbar : navigation -->
                <ul class="navbar-nav">


                    <!-- Главная - карта -->
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Карта
                        </a>
                    </li>

                    <!-- О проекте -->
                    <li class="nav-item">
                        <a class="nav-link" href="/about">
                            О проекте
                        </a>
                    </li>
                </ul>
                <!-- /navbar : navigation -->
            </div>

            <!-- OPTIONS -->
            <ul class="list-inline list-unstyled mb-0 d-flex align-items-end">
                @if (SignInManager.IsSignedIn(User))
                {
                    // для авторизованного пользователя
                    <li class="list-inline-item mx-1 float-start">
                        <a href="/object/add" class="btn btn-sm btn-outline-light rounded-pill btn-add-object-responsive">
                            <i class="fi fi-plus me-1"></i><span class="btn-text">Добавить объект</span>
                        </a>
                    </li>

                    <li class="list-inline-item mx-1 dropdown float-start">

                        <a href="#" id="dropdownAccountOptions" class="btn btn-sm rounded-circle btn-primary js-stoppropag" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                            <span class="group-icon">
                                <i class="fi fi-user-male"></i>
                                <i class="fi fi-close"></i>
                            </span>
                        </a>

                        <div aria-labelledby="dropdownAccountOptions" class="prefix-link-icon prefix-icon-dot dropdown-menu dropdown-menu-clean dropdown-click-ignore end-0 p-2" style="min-width:215px;">
                            <div class="list-unstyled">
                                <div class="dropdown-header">
                                    @userFullName
                                </div>
                                <div class="dropdown-divider"></div>
                                <a asp-controller="Profile" asp-action="ProfileHome" class="dropdown-item text-truncate fw-light active">
                                    Мой профиль
                                </a>
                                <a asp-controller ="Profile" asp-action="MyObjects" class="dropdown-item text-truncate fw-light">
                                    Mои объекты
                                </a>
                                <a asp-controller="Profile" asp-action="MyReviews" class="dropdown-item text-truncate fw-light">
                                    Mои отзывы
                                </a>
                                @if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
                                {
                                    <div class="dropdown-divider"></div>
                                    <a asp-controller="Moderator" asp-action="ModeratorPanel" class="dropdown-item text-truncate fw-light ">
                                        Панель модератора
                                        @if (pendingCount > 0)
                                        {
                                            <span class="badge bg-warning ms-2">@pendingCount</span>
                                        }
                                    </a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="dropdown-divider"></div>
                                    <a asp-controller="Admin" asp-action="AdminPanel" class="dropdown-item text-truncate fw-light">
                                        Панель администратора
                                    </a>
                                }
                                <div class="dropdown-divider mb-0"></div>
                                <a asp-controller="Account" asp-action="Logout" class="prefix-icon-ignore dropdown-footer dropdown-custom-ignore">
                                    <i class="fi fi-power float-start"></i>
                                    Выйти
                                </a>
                            </div>
                        </div>

                    </li>
                }
                else
                {
                    // для неавторизованного пользователя
                    <li class="list-inline-item mx-1 float-start">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light rounded-pill">
                            Войти
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </header>
    <!-- /Header -->

    <!-- Основное содержимое -->
    <main class="pt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer id="footer" class=" bg-dark text-white py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h5 class="text-white mb-4">Социальный навигатор</h5>
                    <p>Карта доступности городских объектов для маломобильных групп населения</p>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="text-white mb-4">Навигация</h6>
                    <ul class="list-unstyled">
                        <li><a href="/" class="text-white-50 text-decoration-none"> Карта</a></li>
                        <li><a href="/about" class="text-white-50 text-decoration-none"> О проекте</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4 mb-4">
                    <h6 class="text-white mb-4">Помощь</h6>
                    <ul class="list-unstyled">
                        <li><a href="/about#work" class="text-white-50 text-decoration-none">Как работать с картой</a></li>
                    </ul>
                </div>
            </div>
            <hr class="bg-white-20">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0 small">©2026. Все права защищены.</p>
                </div>
            </div>
        </div>
    </footer>
    <!-- /Footer -->

    <script src="~/frontend/assets/js/core.min.js"></script>
    <script src="~/frontend/assets/js/vendor_bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>