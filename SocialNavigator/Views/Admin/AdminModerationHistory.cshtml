@model IEnumerable<Domain.DTO.ModerationHistoryDto>
@using Domain.Entity.Enums
@{
    ViewData["Title"] = "История модерации";
}

<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-4">История модерации</h1>
                <p class="lead mb-0">Все действия модераторов в системе</p>

                <div class="clearfix mt-5">
                    <a asp-action="AdminPanel" class="btn btn-outline-light btn-pill mx-2" style="border-color: var(--bs-primary); color: var(--bs-primary)">
                        <i class="fi fi-arrow-left"></i> Назад
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Блок: история -->
<div class="section bg-light py-4">
    <div class="container">

        <!-- Поиск -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">                               
                <form method="get" class="row g-3">
                    <div class="col-md-10">
                        <label class="form-label">Поиск по названию или адресу</label>
                        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Название или адрес...">
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary btn-pill scroll-to mx-2 px-5 ms-3">
                            Найти
                        </button>
                    </div>
                </form>
            </div>
        </div>
                
        <!-- Список истории модерации -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Дата</th>
                                    <th>Объект</th>
                                    <th>Модератор</th>
                                    <th>Изменение статуса</th>
                                    <th>Комментарий</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-nowrap">@item.ModeratedAt.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <strong>@item.ObjectName</strong>
                                        </td>
                                        <td>@item.ModeratorName</td>
                                        <td>
                                            @if (item.OldStatus != null)
                                            {
                                                <span class="badge bg-secondary me-1">
                                                    @if (item.OldStatus == "Pending") { <text>На модерации</text> }
                                                    else if (item.OldStatus == "Approved") { <text>Одобрен</text> }
                                                    else if (item.OldStatus == "Rejected") { <text>Отклонен</text> }
                                                    else { @item.OldStatus }
                                                </span>
                                                <i class="fi fi-arrow-right mx-1"></i>
                                            }
                                            @if (item.NewStatus == "Approved")
                                            {
                                                <span class="badge bg-success">Одобрен</span>
                                            }
                                            else if (item.NewStatus == "Rejected")
                                            {
                                                <span class="badge bg-danger">Отклонен</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warring">
                                                    @if (item.NewStatus == "Pending") { <text>На модерации</text> }
                                                    else { @item.NewStatus }
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Comment))
                                            {
                                                <span title="@item.Comment">@(item.Comment.Length > 50 ? item.Comment.Substring(0, 50) + "..." : item.Comment)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-12 mx-auto">
                            <div class="text-center py-5">
                                <div class="card-body">
                                    <h3 class="fw-bold mb-3">
                                        История модерации пуста
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>