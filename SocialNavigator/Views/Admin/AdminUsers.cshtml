@model IEnumerable<Domain.DTO.AppUserDto>
@{
    ViewData["Title"] = "Управление пользователями";
}

<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-4">Управление пользователями</h1>
                <p class="lead mb-0">Активация, деактивация и смена ролей</p>

                <div class="clearfix mt-5">
                    <a asp-action="AdminPanel" class="btn btn-outline-light btn-pill mx-2" style="border-color: var(--bs-primary); color: var(--bs-primary)">
                        <i class="fi fi-arrow-left"></i> Назад
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Блок: пользователи -->
<div class="section bg-light py-4">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Фильтры и поиск -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Поиск</label>
                        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Имя, email или логин...">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Роль</label>
                        <select name="role" class="form-select">
                            <option value="">Все роли</option>
                            @foreach (var role in ViewBag.Roles)
                            {
                                <option value="@role.Key" selected="@(ViewBag.RoleFilter == role.Key)">
                                    @role.Value
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Статус</label>
                        <select name="active" class="form-select">
                            <option value="">Все</option>
                            <option value="true" selected="@(ViewBag.ActiveFilter == true)">Активные</option>
                            <option value="false" selected="@(ViewBag.ActiveFilter == false)">Неактивные</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary btn-pill scroll-to mx-2 px-5 ms-3">
                            Найти
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Список пользователей -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Пользователь</th>
                                    <th>Email</th>
                                    <th>Роль</th>
                                    <th>Статус</th>
                                    <th>Дата регистрации</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@(user.FullName ?? user.UserName)</strong>
                                            <br><small class="text-muted">@@@user.UserName</small>
                                        </td>
                                        <td>@user.Email</td>
                                        <td>
                                            @if (user.Role == "User")
                                            {
                                                <span class="badge rounded-pill bg-info">Пользователь</span>
                                            }

                                            @if (user.Role == "Moderator")
                                            {
                                                <span class="badge rounded-pill bg-warning">Модератор</span>
                                            }

                                            @if (user.Role == "Admin")
                                            {
                                                <span class="badge rounded-pill bg-danger ">Администратор</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.Active)
                                            {
                                                <span class="badge bg-success rounded-pill">Активен</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill">Неактивен</span>
                                            }
                                        </td>
                                        <td>@user.UserCreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td class="text-center">
                                            <div class="dropdown">
                                                <a href="#" class="dropdown-toggle-icon d-inline-flex align-items-center justify-content-center"
                                                   role="button"
                                                   data-bs-toggle="dropdown"
                                                   aria-expanded="false"
                                                   style="text-decoration: none; color: var(--bs-primary); font-size: 1.5rem; line-height: 1; width: 40px; height: 40px;">
                                                    <i class="fi fi-dots-vertical"></i>
                                                </a>

                                                <ul class="dropdown-menu dropdown-menu-end py-2" style="min-width: 220px;">
                                                    <li>
                                                        <button class="dropdown-item py-2 @(user.Active ? "text-danger" : "text-success")"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#statusModal-@user.IdUser">
                                                            @(user.Active ? "Деактивировать" : "Активировать")
                                                        </button>
                                                    </li>
                                                    @if (user.UserName != User.Identity.Name)
                                                    {
                                                        <li><hr class="dropdown-divider my-1"></li>
                                                        <li>
                                                            <button class="dropdown-item py-2 text-primary"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#roleModal-@user.IdUser">
                                                                Сменить роль
                                                            </button>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Модальное окно для изменения статуса -->
                                    <div class="modal fade" id="statusModal-@user.IdUser" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">
                                                        @(user.Active ? "Деактивация пользователя" : "Активация пользователя")
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="ChangeUserStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@user.IdUser" />
                                                    <div class="modal-body">
                                                        <div class="text-center py-3">
                                                            <i class="fi fi-loading-dots fs-1 text-@(user.Active ? "danger" : "success")"></i>
                                                            <p class="mt-3 mb-0">
                                                                Вы действительно хотите <strong>@(user.Active ? "деактивировать" : "активировать")</strong> пользователя
                                                            </p>
                                                            <p class="fw-bold">@(user.FullName ?? user.UserName)</p>
                                                            @if (user.Active)
                                                            {
                                                                <div class="alert alert-danger mt-3">  
                                                                    После деактивации пользователь не сможет войти в систему.
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="alert alert-success mt-3">
                                                                    После активации пользователь сможет войти в систему.
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer d-flex justify-content-between">
                                                        <button type="button" class="btn btn-outline-secondary btn-pill" data-bs-dismiss="modal">
                                                            Отмена
                                                        </button>
                                                        <button type="submit" class="btn btn-@(user.Active ? "danger" : "success") btn-pill">
                                                            @(user.Active ? "Деактивировать" : "Активировать")
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Модальное окно для изменения роли -->
                                    @if (user.UserName != User.Identity.Name)
                                    {
                                        <div class="modal fade" id="roleModal-@user.IdUser" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Изменение роли пользователя</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-action="ChangeUserRole" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.IdUser" />
                                                        <div class="modal-body">
                                                            <div class="text-center py-3">
                                                                <i class="fi fi-users fs-1 text-info"></i>
                                                                <p class="mt-3 mb-0">
                                                                    Выберите новую роль для пользователя
                                                                </p>
                                                                <p class="fw-bold">@(user.FullName ?? user.UserName)</p>

                                                                <div class="mt-4">
                                                                    <select name="newRole" class="form-select form-select-lg">
                                                                        <option value="User" selected="@(user.Role == "User")">Пользователь</option>
                                                                        <option value="Moderator" selected="@(user.Role == "Moderator")">Модератор</option>
                                                                        <option value="Admin" selected="@(user.Role == "Admin")">Администратор</option>
                                                                    </select>
                                                                </div>

                                                                <div class="alert alert-info mt-4">
                                                                    <i class="fi fi-info-circle me-2"></i>
                                                                    Изменение роли повлияет на доступные пользователю функции.
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer d-flex justify-content-between">
                                                            <button type="button" class="btn btn-outline-secondary btn-pill" data-bs-dismiss="modal">
                                                                Отмена
                                                            </button>
                                                            <button type="submit" class="btn btn-primary btn-pill">
                                                                Сохранить
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-12 mx-auto">
                            <div class="text-center py-5">
                                <div class="card-body">
                                    <h3 class="fw-bold mb-3">
                                        Пользователи не найдены
                                    </h3>
                                    <p class="text-muted mb-4">Попробуйте изменить параметры поиска</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>