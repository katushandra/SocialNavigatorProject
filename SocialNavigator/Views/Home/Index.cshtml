@model IEnumerable<Domain.DTO.SocialObjectDto>
@{
    ViewData["Title"] = "Главная страница";
    var objectTypes = ViewBag.ObjectTypes as IEnumerable<Domain.DTO.ObjectTypeDto> ?? new List<Domain.DTO.ObjectTypeDto>();
}

<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <!-- Заголовок -->
                <h1 class="display-4 fw-bold mb-4">Карта доступности</h1>

                <!-- Описание -->
                <p class="lead mb-0">Найдите информацию о доступности городских объектов для маломобильных групп населения</p>

                <!-- Кнопки действий -->
                <div class="clearfix mt-5">
                    <a href="#objects" class="btn btn-primary btn-pill scroll-to mx-2">
                        <i class="fi fi-search me-2"></i>Найти объекты
                    </a>
                    <a href="#map" class="btn btn-outline-light btn-pill scroll-to mx-2" style="border-color: var(--bs-primary); color: var(--bs-primary)">
                        <i class="fi fi-map me-2"></i>Открыть карту
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Блок: карта/список объектов -->
<div id="objects" class="section bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h1 fw-bold mb-0">Объекты</h2>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-primary active" data-view="list">
                    <i class="fi fi-list"></i> Список
                </button>
                <button type="button" class="btn btn-outline-primary" data-view="map">
                    <i class="fi fi-map"></i> Карта
                </button>
            </div>
        </div>

        <!-- Список -->
        <div id="objects-container" class="row">
            <div class="col-12">
                @if (Model != null && Model.Any())
                {
                    @foreach (var obj in Model)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">@obj.Name</h5>
                                <p class="card-text text-muted">
                                    <i class="fi fi-pin-2"></i> @obj.Address<br>
                                    <i class="fi fi-arrow-end"></i> @obj.ObjectType?.NameObjectType
                                </p>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @if (obj.Wheelchairs)
                                    {
                                        <span class="badge rounded-pill bg-success">На креслах-колясках</span>
                                    }
                                    @if (obj.BlindAccess)
                                    {
                                        <span class="badge rounded-pill bg-light text-dark">С нарушениями зрения</span>
                                    }
                                    @if (obj.DeafAccess)
                                    {
                                        <span class="badge rounded-pill bg-warning ">С нарушениями слуха</span>
                                    }
                                    @if (obj.SpeechAccess)
                                    {
                                        <span class="badge rounded-pill bg-primary-soft ">С нарушениями речи</span>
                                    }
                                    @if (obj.MobilityAccess)
                                    {
                                        <span class="badge rounded-pill bg-secondary">С нарушениями ОДА</span>
                                    }
                                    @if (obj.IntellectualAccess)
                                    {
                                        <span class="badge rounded-pill bg-danger">С умственными нарушениями</span>
                                    }
                                    @if (obj.AutismAccess)
                                    {
                                        <span class="badge rounded-pill bg-info">С нарушениями поведения и общения </span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <!-- Показ звезд -->
                                    <div>
                                        <span class="text-warning">
                                            @{
                                                var score = obj.ScoreObject;
                                                for (int i = 0; i < 5; i++)
                                                {
                                                    if (i < Math.Floor(score))
                                                    {
                                                        <i class="fi fi-star-filled"></i>
                                                    }
                                                    else if (i < score)
                                                    {
                                                        <i class="fi fi-star-half"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fi fi-star"></i>
                                                    }
                                                }
                                            }
                                        </span>
                                        <span class="ms-2">@obj.ScoreObject.ToString("F1")</span>
                                    </div>
                                    <a href="/object/@obj.IdObject" class="btn btn-sm btn-primary">
                                        Подробнее
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        На данный момент нет доступных объектов для отображения.
                    </div>
                }
            </div>
        </div>

        <!-- Карта -->
        <div id="map-container" class="row d-none">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- переключение между списком и картой -->
<script>
    document.querySelectorAll('[data-view]').forEach(button => {
        button.addEventListener('click', function() {
            const view = this.getAttribute('data-view');

            document.querySelectorAll('[data-view]').forEach(btn => {
                btn.classList.remove('active');
            });
            this.classList.add('active');

            if (view === 'list') {
                document.getElementById('objects-container').classList.remove('d-none');
                document.getElementById('map-container').classList.add('d-none');
            } else {
                document.getElementById('objects-container').classList.add('d-none');
                document.getElementById('map-container').classList.remove('d-none');
            }
        });
    });
</script>

<!-- Блок: поиск объектов -->
<div id="search" class="section bg-white">
    <div class="container">
        <h2 class="h1 fw-bold text-center mb-5">Поиск объектов</h2>

        <div class="row">
            <div class="col-lg-8 mx-auto">
                <!-- Форма поиска -->
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4">
                        <form id="searchForm" class="row g-4">
                            <!-- Поле поиска -->
                            <div class="col-12">
                                <label for="searchQuery" class="form-label">Поиск по названию или адресу</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0">
                                        <i class="fi fi-search"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control"
                                           id="searchQuery"
                                           placeholder="Введите название объекта или адрес...">
                                </div>
                            </div>

                            <!-- Тип объекта -->
                            <div class="col-12 mt-3">
                                <label for="objectType" class="form-label">Тип объекта</label>
                                <select class="form-select" id="objectType">
                                    <option value="">Все типы</option>
                                    <option value="mediko_socialnaya_ekspertiza">Медико-социальная экспертиза</option>
                                    <option value="socialnaya_zaschita_naseleniya">Социальная защита населения</option>
                                    <option value="zdravoohranenie">Здравоохранение</option>
                                    <option value="obrazovanie">Образование</option>
                                    <option value="inklyuzivny_detskiy_otdyh">Инклюзивный детский отдых</option>
                                    <option value="kultura">Культура</option>
                                    <option value="fizicheskaya_kultura_i_sport">Физическая культура и спорт</option>
                                    <option value="sfr">СФР</option>
                                    <option value="pfr">ПФР</option>
                                    <option value="fss">ФСС</option>
                                    <option value="nalogovaya_sluzhba">Налоговая служба</option>
                                    <option value="svyaz_i_informaciya">Связь и информация</option>
                                    <option value="zhilye_zdaniya_i_pomescheniya">Жилые здания и помещения</option>
                                    <option value="potrebitelskiy_rynok_i_sfera_uslug">Потребительский рынок и сфера услуг</option>
                                    <option value="mesta_prilozheniya_truda">Места приложения труда</option>
                                    <option value="dorozhno_transportnye">Дорожно-транспортные</option>
                                    <option value="administrativnye_organizacii_i_uchrezhdeniya">Административные организации и учреждения</option>
                                    <option value="molodezhnaya_politika">Молодежная политика</option>
                                </select>
                            </div>

                            <!-- Доступность -->
                            <div class="col-12 mt-3">
                                <label for="accessibility" class="form-label">Доступность</label>
                                <select class="form-select" id="accessibility">
                                    <option value="">Любая доступность</option>
                                    <option value="wheelchairs">Для людей, передвигающихся на креслах-колясках</option>
                                    <option value="blind_access">Для людей с нарушениями зрения</option>
                                    <option value="deaf_access">Для людей с нарушениями слуха</option>
                                    <option value="speech_access">Для людей с нарушениями речи</option>
                                    <option value="mobility_access">Для людей с нарушениями опорно-двигательного аппарата</option>
                                    <option value="intellectual_access">Для людей с умственными нарушениями</option>
                                    <option value="autism_access">Для людей с нарушениями поведения и общения</option>
                                </select>
                            </div>

                            <!-- Кнопки -->
                            <div class="col-12 text-center mt-4">
                                <button type="submit" class="btn btn-primary btn-lg px-5">
                                    Найти
                                </button>
                                <button type="reset" class="btn btn-outline-secondary btn-lg px-5 ms-3">
                                    Сбросить
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>