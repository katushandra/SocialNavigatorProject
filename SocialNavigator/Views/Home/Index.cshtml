@model IEnumerable<Domain.DTO.SocialObjectDto>
@{
    ViewData["Title"] = "Главная страница";
}
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-4">Карта доступности</h1>
                <p class="lead mb-0">Найдите информацию о доступности городских объектов для маломобильных групп населения</p>
            </div>
        </div>
    </div>
</div>

<!-- Блок: карта/список объектов и поиск-->
<div id="objects" class="section bg-light pt-5">
    <div class="container">

        <!-- Фильтры и поиск -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <form method="get" class="row g-3" id="filterForm" action="@Url.Action("Index", "Home")">
                    <div class="col-md-12">
                        <label class="form-label">Поиск по названию или адресу</label>
                        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Название или адрес...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Доступность</label>
                        <select name="accessibility" class="form-select">
                            <option value="">Любая доступность</option>
                            <option value="wheelchairs" selected="@(ViewBag.AccessibilityFilter == "wheelchairs")">Для людей, передвигающихся на креслах-колясках</option>
                            <option value="blind" selected="@(ViewBag.AccessibilityFilter == "blind")">Для людей с нарушениями зрения</option>
                            <option value="deaf" selected="@(ViewBag.AccessibilityFilter == "deaf")">Для людей с нарушениями слуха</option>
                            <option value="speech" selected="@(ViewBag.AccessibilityFilter == "speech")">Для людей с нарушениями речи</option>
                            <option value="mobility" selected="@(ViewBag.AccessibilityFilter == "mobility")">Для людей с нарушениями опорно-двигательного аппарата</option>
                            <option value="intellectual" selected="@(ViewBag.AccessibilityFilter == "intellectual")">Для людей с умственными нарушениями</option>
                            <option value="autism" selected="@(ViewBag.AccessibilityFilter == "autism")">Для людей с нарушениями поведения и общения</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Тип объекта</label>
                        <select name="objectType" class="form-select">
                            <option value="">Все типы</option>
                            @if (ViewBag.ObjectTypes != null)
                            {
                                @foreach (var type in ViewBag.ObjectTypes)
                                {
                                    <option value="@type" selected="@(ViewBag.ObjectTypeFilter == type)">@type</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 text-center mt-3">
                        <button type="submit" class="btn btn-primary btn-pill px-5 ms-3">
                            Найти
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-pill px-5 ms-3" id="resetBtn">
                            Сбросить
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Скрытие карты -->
        <div class="text-end mb-3">
            <a href="#" id="toggleMapBtn" class="text-decoration-none">
                <i class="fi fi-map me-2"></i>Скрыть карту
            </a>
        </div>

        <!-- Карта -->
        <div id="map-container" class="row" style="display: block;">
            <div class="col-12">
                <div id="map" style="height: 500px; width: 100%; border-radius: 12px; margin-bottom: 30px;"></div>
            </div>
        </div>

        <!-- Список -->
        <div id="objects-container" class="row">
            <div class="col-12">
                @if (Model != null && Model.Any())
                {
                    foreach (var obj in Model)
                    {
                        <div class="card mb-3 object-card" data-object-id="@obj.IdObject" style="display: block; transition: all 0.2s ease;">
                            <div class="card-body">
                                <h5 class="card-title mb-2">@obj.Name</h5>
                                <p class="card-text text-muted mb-3">
                                    <span class="badge rounded-pill bg-primary text-white px-4 mb-2">
                                        @obj?.ObjectType?.NameObjectType
                                    </span> <br>
                                    <i class="fi fi-pin-2"></i> @obj.Address
                                </p>

                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @if (obj.Wheelchairs)
                                    {
                                        <span class="badge rounded-pill bg-success">На креслах-колясках</span>
                                    }
                                    @if (obj.BlindAccess)
                                    {
                                        <span class="badge rounded-pill bg-light text-dark">С нарушениями зрения</span>
                                    }
                                    @if (obj.DeafAccess)
                                    {
                                        <span class="badge rounded-pill bg-warning">С нарушениями слуха</span>
                                    }
                                    @if (obj.SpeechAccess)
                                    {
                                        <span class="badge rounded-pill bg-primary-soft">С нарушениями речи</span>
                                    }
                                    @if (obj.MobilityAccess)
                                    {
                                        <span class="badge rounded-pill bg-secondary">С нарушениями ОДА</span>
                                    }
                                    @if (obj.IntellectualAccess)
                                    {
                                        <span class="badge rounded-pill bg-danger">С умственными нарушениями</span>
                                    }
                                    @if (obj.AutismAccess)
                                    {
                                        <span class="badge rounded-pill bg-info">С нарушениями поведения и общения</span>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <!-- Показ звезд -->
                                    <div>
                                        <span class="text-warning">
                                            @{
                                                decimal score = obj?.ScoreObject ?? 0;
                                                int fullStar = (int)Math.Floor(score);
                                                bool halfStar = (score - fullStar) >= 0.5m;

                                                for (int i = 0; i < fullStar; i++)
                                                {
                                                    <i class="fi fi-star-full"></i>
                                                }

                                                if (halfStar)
                                                {
                                                    <i class="fi fi-start-half"></i>
                                                }

                                                int emptyStar = 5 - fullStar - (halfStar ? 1 : 0);
                                                for (int i = 0; i < emptyStar; i++)
                                                {
                                                    <i class="fi fi-star-empty"></i>
                                                }
                                            }
                                        </span>
                                        <span class="ms-2">@obj.ScoreObject.ToString("F1")</span>
                                    </div>
                                    <div class="d-flex gap-2 ms-4 align-items-center">
                                        <a asp-controller="Object" asp-action="Full" asp-route-id="@obj.IdObject" class="btn btn-sm btn-outline-primary btn-pill">
                                            Подробнее
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        На данный момент нет доступных объектов для отображения.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://api-maps.yandex.ru/2.1/?apikey=@Configuration["YandexMaps:ApiKey"]&lang=ru_RU"></script>
    <script>
        let map;
        let placemarks = [];
        let selectedObjectId = null;
        let selectedPlacemark = null; 
        const mapObjects = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MapObjects));

        // Выделение карточки объекта всписке
        function highlightObjectCard(objectId) 
        {
            document.querySelectorAll('.object-card').forEach(card => {
                card.classList.remove('border', 'border-primary', 'shadow-sm');
                card.style.border = '';
            });

            const selectedCard = document.querySelector(`.object-card[data-object-id="${objectId}"]`);
            if (selectedCard) 
            {
                selectedCard.classList.add('border', 'border-primary', 'shadow-sm');
                selectedCard.style.border = '2px solid var(--bs-primary)';
            }
        }

        // Изменения маркера
        function updatePlacemark(objectId) 
        {
            placemarks.forEach(placemark => {
                if (placemark.options) 
                {
                    placemark.options.set('preset', 'islands#redDotIcon');
                }
            });

            if (objectId) 
            {
                const selectedPlacemarkIndex = placemarks.findIndex((p, index) => {
                    const obj = mapObjects[index];
                    return obj && obj.IdObject === objectId;
                });

                if (selectedPlacemarkIndex !== -1 && placemarks[selectedPlacemarkIndex]) 
                {
                    placemarks[selectedPlacemarkIndex].options.set('preset', 'islands#redCircleDotIcon');
                    selectedPlacemark = placemarks[selectedPlacemarkIndex];
                }
            } 
            else 
            {
                selectedPlacemark = null;
            }
        }

        // Инициализация карты
        function initMap() {
            const defaultCenter = [59.9343, 30.3351];
            let center = defaultCenter;
            let zoom = 10;

            map = new ymaps.Map('map', {
                center: center,
                zoom: zoom,
                controls: ['zoomControl', 'fullscreenControl', 'geolocationControl']
            });

            addPlacemarks();
        }

        // Добавление маркеров на карту
        function addPlacemarks() 
        {
            placemarks.forEach(placemark => {
                map.geoObjects.remove(placemark);
            });
            placemarks = [];

            if (!mapObjects || mapObjects.length === 0) return;

            mapObjects.forEach((obj, index) => 
            {
                const placemark = new ymaps.Placemark(
                    [obj.Latitude, obj.Longitude],
                    {}, 
                    {
                        preset: 'islands#redDotIcon',
                        draggable: false,
                        hasBalloon: false, 
                        hideIconOnBalloonOpen: false
                    }
                );

                //  фильтрация списка при клике на маркер
                placemark.events.add('click', function() {
                    filterObjectsByMarker(obj.IdObject);
                    map.setCenter([obj.Latitude, obj.Longitude], 15);
                });

                map.geoObjects.add(placemark);
                placemarks.push(placemark);
            });
        }

        // Фильтрация списка объектов по клику на маркер
        function filterObjectsByMarker(objectId) 
        {
            selectedObjectId = objectId; // id выбранного объекта            

            const allCards = document.querySelectorAll('.object-card'); // все карточки

            allCards.forEach(card => {
                card.style.display = 'block'; // показать
            });

            highlightObjectCard(objectId); // нужная карточка с обводкой
            updatePlacemark(objectId); // изменение маркера

            // скролл к выбранной карточке
            const selectedCard = document.querySelector(`.object-card[data-object-id="${objectId}"]`);
            if (selectedCard) 
            {
                selectedCard.scrollIntoView({ behavior: 'smooth', block: 'start' }); 
            }
        }     

        // Функция для переключения видимости карты (кнопка скрыть карту)
        function toggleMapVisibility() 
        {
            const mapContainer = document.getElementById('map-container');
            const toggleBtn = document.getElementById('toggleMapBtn');

            if (mapContainer.style.display === 'none') 
            {
                mapContainer.style.display = 'block';
                toggleBtn.innerHTML = '<i class="fi fi-map me-2"></i>Скрыть карту';

                if (map) 
                {
                    setTimeout(() => {
                        map.container.fitToViewport();
                    }, 100);
                }
            } 
            else 
            {
                mapContainer.style.display = 'none';
                toggleBtn.innerHTML = '<i class="fi fi-map me-2"></i>Открыть карту';
            }
        }

        document.addEventListener('DOMContentLoaded', function() 
        {
            // Инициализация карты
            ymaps.ready(function() {
                initMap();
            });

            // Обработчик кнопки Скрыть карту
            const toggleBtn = document.getElementById('toggleMapBtn');
            if (toggleBtn) 
            {
                toggleBtn.addEventListener('click', toggleMapVisibility);
            }

            // Обработчик кнопки Сбросить
            const resetBtn = document.getElementById('resetBtn');
            if (resetBtn)
            {
                resetBtn.addEventListener('click', function() {

                document.querySelector('input[name="searchTerm"]').value = '';
                document.querySelector('select[name="objectType"]').value = '';
                document.querySelector('select[name="accessibility"]').value = '';

                const form = document.getElementById('filterForm');
                form.submit();
            });
        }
    });
    </script>
}