@{
    ViewData["Title"] = "О проекте";
}
<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <!-- Заголовок -->
                <h1 class="display-4 fw-bold mb-4">О проекте</h1>

                <!-- Описание -->
                <p class="lead mb-0">Карта доступности городских объектов для маломобильных групп населения</p>
            </div>
        </div>
    </div>
</div>

<!-- Блок: описание проекта -->
<div id="project-description" class="section bg-white">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="h1 fw-bold mb-4">Что такое "Социальный навигатор"?</h2>

                <p class="fs-5 mb-4">
                    "Социальный навигатор" — это интерактивная карта доступности городских объектов для людей с ограниченными возможностями здоровья и маломобильных групп населения.
                </p>

                <div class="row mt-5">
                    <div class="col-md-4 mb-4">
                        <div class="text-center">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="fi fi-map fs-2"></i>
                            </div>
                            <h4 class="h5 fw-bold">Карта объектов</h4>
                            <p class="text-muted">Интерактивная карта с отображением доступных городских объектов</p>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="text-center">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="fi fi-squared-info fs-2"></i>
                            </div>
                            <h4 class="h5 fw-bold">Детальная информация</h4>
                            <p class="text-muted">Подробные сведения о доступности объектов для разных категорий</p>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="text-center">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="fi fi-users fs-2"></i>
                            </div>
                            <h4 class="h5 fw-bold">Сообщество</h4>
                            <p class="text-muted">Возможность добавлять объекты и оставлять отзывы</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

