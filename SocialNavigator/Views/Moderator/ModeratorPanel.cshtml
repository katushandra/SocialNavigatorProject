@using Domain.Entity.Enums
@model IEnumerable<Domain.DTO.ModerationSocialObjectDto>
@{
    ViewData["Title"] = "Панель модератора";
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int>;
    var totalCount = statusCounts?.Sum(x => x.Value) ?? 0;
}

<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-4">Панель модератора</h1>
                <p class="lead mb-0">Управление объектами на карте</p>
            </div>
        </div>
    </div>
</div>

<!-- Блок: объекты -->
<div class="section bg-light">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Количесто объектов, ожидающих модерции -->
        @if (ViewBag.PendingCount > 0)
        {
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                <strong>Ожидает модерации: @ViewBag.PendingCount</strong>
                @if (ViewBag.PendingCount == 1)
                {
                    <span>объект</span>
                }
                else if (ViewBag.PendingCount >= 2 && ViewBag.PendingCount <= 4)
                {
                    <span>объекта</span>
                }
                else
                {
                    <span>объектов</span>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <!-- Навигация по статусам -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <ul class="nav nav-lg nav-invert">
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == null || ViewBag.CurrentStatus == "all" ? "active" : "")"
                       asp-action="ModeratorPanel" asp-route-status="all">
                       Все <span class="badge bg-secondary ms-2">@totalCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == "Pending" ? "active" : "")"
                       asp-action="ModeratorPanel" asp-route-status="Pending">
                       На модерации <span class="badge bg-warning ms-2">@(statusCounts != null && statusCounts.ContainsKey("Pending") ? statusCounts["Pending"] : 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == "Approved" ? "active" : "")"
                       asp-action="ModeratorPanel" asp-route-status="Approved">
                       Одобренные <span class="badge bg-success ms-2">@(statusCounts != null && statusCounts.ContainsKey("Approved") ? statusCounts["Approved"] : 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == "Rejected" ? "active" : "")"
                       asp-action="ModeratorPanel" asp-route-status="Rejected">
                       Отклоненные <span class="badge bg-danger ms-2">@(statusCounts != null && statusCounts.ContainsKey("Rejected") ? statusCounts["Rejected"] : 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == "Archived" ? "active" : "")"
                       asp-action="ModeratorPanel" asp-route-status="Archived">
                        В архиве <span class="badge bg-light text-dark ms-2">@(statusCounts != null && statusCounts.ContainsKey("Archived") ? statusCounts["Archived"] : 0)</span>
                    </a>
                </li>
            </ul>

            <div class="d-flex gap-2">
                <a asp-action="ModeratorHistory" class="btn btn-info btn-pill">
                    История модерации
                </a>
            </div>
        </div>

        <!-- Список объектов -->
        <div id="objects-container" class="row">
            <div class="col-12">

                @if (Model != null && Model.Any())
                {
                    @foreach (var obj in Model)
                    {
                        <div class="card mb-3">
                            <div class="card-body d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-2">@obj.Name</h5>
                                    <p class="card-text text-muted mb-0">
                                        <span class="badge rounded-pill bg-primary text-white px-5 mb-2">
                                            @obj?.ObjectType?.NameObjectType
                                        </span>
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @if (obj.Status == Status.Pending)
                                            {
                                                <span class="badge rounded-pill bg-warning">На модерации</span>
                                            }
                                            @if (obj.Status == Status.Approved)
                                            {
                                                <span class="badge rounded-pill bg-success">Одобрен</span>
                                            }
                                            @if (obj.Status == Status.Rejected)
                                            {
                                                <span class="badge rounded-pill bg-danger">Отклонен</span>
                                            }
                                            @if (obj.Status == Status.Archived)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark">В архиве</span>
                                            }
                                        </div>
                                        <i class="fi fi-pin-2 me-1"></i> @obj.Address<br>
                                        <i class="fi fi-calendar me-1"></i> Создан: @obj.CreatedAt.ToString("dd.MM.yyyy")<br>
                                        <i class="fi fi-user-male me-1"></i> Автор: @obj.CreatorName
                                    </p>
                                </div>

                                <div class="d-flex gap-2 ms-4 align-items-center">
                                    <a asp-action="ModeratorFull" asp-route-id="@obj.IdObject" class="btn btn-sm btn-outline-primary btn-pill">
                                        Подробнее
                                    </a>
                                </div>                                  
                               
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Отсутствие объектов -->
                    <div class="row">
                        <div class="col-12 mx-auto">
                            <div class="card border-0 shadow-sm text-center py-5">
                                <div class="card-body">
                                    <h3 class="fw-bold mb-0">
                                        @if (ViewBag.CurrentStatus != null && ViewBag.CurrentStatus != "all")
                                        {
                                            <span>
                                                Нет объектов со статусом
                                                @switch (ViewBag.CurrentStatus)
                                                {
                                                    case "Pending":
                                                        <span class="badge rounded-pill bg-warning">На модерации</span>
                                                        break;
                                                    case "Approved":
                                                        <span class="badge rounded-pill bg-success">Одобрен</span>
                                                        break;
                                                    case "Rejected":
                                                        <span class="badge rounded-pill bg-danger">Отклонен</span>
                                                        break;
                                                    case "Archived":
                                                        <span class="badge rounded-pill bg-light text-dark">Заархивирован</span>
                                                        break;
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Нет объектов для отображения</span>
                                        }
                                    </h3>                                   
                                </div>
                            </div>
                        </div>
                    </div>                    
                }
            </div>
        </div>
    </div>
</div>