@model Domain.DTO.FullSocialObjectDto
@using Microsoft.AspNetCore.Identity
@using Domain.Entity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@{
    ViewData["Title"] = Model.SocialObjectDto?.Name ?? "Карточка объекта";
    var obj = Model.SocialObjectDto;
    var user = await UserManager.GetUserAsync(User);
    var hasUserReviewed = Model.Reviews?.Any(r => r.AppUser?.IdUser == user?.Id) ?? false;
}
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <!-- Название объекта -->
                <h1 class="display-4 fw-bold mb-4">@obj?.Name</h1>

                <!-- Тип объекта -->
                <div class="mb-3">
                    <span class="badge bg-primary text-white px-4 py-2 rounded-pill">
                        @obj?.ObjectType?.NameObjectType
                    </span>
                </div>

                <!-- Адрес -->
                <p class="lead text-white-80 mb-0">
                    <i class="fi fi-pin-2 me-2"></i>@obj?.Address
                </p>

                <!-- Кнопка -->
                <div class="clearfix mt-5">
                    <a href="javascript:void(0)" onclick="window.history.back()" class="btn btn-outline-light btn-pill mx-2" style="border-color: var(--bs-primary); color: var(--bs-primary)">
                        <i class="fi fi-arrow-left"></i> Назад
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Блок: вся информация -->
<div class="section bg-light py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Левая колонка -->
            <div class="col-lg-8">
                <!-- Блок с описанием -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 class="h4 fw-bold mb-3">
                            <i class="fi fi-squared-info text-primary me-2"></i>Описание
                        </h2>
                        <p class="mb-0">@(!string.IsNullOrEmpty(Model.Description) ? Model.Description : "Описание отсутствует")</p>
                    </div>
                </div>

                <!-- Блок доступности -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 class="h4 fw-bold mb-3">
                            <i class="fi fi-check text-primary me-2"></i>Доступность
                        </h2>
                        <div class="d-flex flex-wrap gap-2">
                            @if (obj != null)
                            {
                                @if (obj.Wheelchairs)
                                {
                                    <span class="badge rounded-pill bg-success">На креслах-колясках</span>
                                }
                                @if (obj.BlindAccess)
                                {
                                    <span class="badge rounded-pill bg-light text-dark">С нарушениями зрения</span>
                                }
                                @if (obj.DeafAccess)
                                {
                                    <span class="badge rounded-pill bg-warning">С нарушениями слуха</span>
                                }
                                @if (obj.SpeechAccess)
                                {
                                    <span class="badge rounded-pill bg-primary-soft">С нарушениями речи</span>
                                }
                                @if (obj.MobilityAccess)
                                {
                                    <span class="badge rounded-pill bg-secondary">С нарушениями ОДА</span>
                                }
                                @if (obj.IntellectualAccess)
                                {
                                    <span class="badge rounded-pill bg-danger">С умственными нарушениями</span>
                                }
                                @if (obj.AutismAccess)
                                {
                                    <span class="badge rounded-pill bg-info">С нарушениями поведения и общения</span>
                                }

                                @if (!obj.Wheelchairs && !obj.BlindAccess && !obj.DeafAccess && !obj.SpeechAccess &&
                                                            !obj.MobilityAccess && !obj.IntellectualAccess && !obj.AutismAccess)
                                {
                                    <span class="text-muted">Информация о доступности отсутствует</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Блок с отзывами -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="h4 fw-bold mb-0">
                                <i class="fi fi-star-empty text-primary me-2"></i>Отзывы  (@(Model.Reviews?.Count ?? 0))
                            </h2>                           
                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            <div class="reviews-list">
                                @foreach (var review in Model.Reviews)
                                {
                                    <div class="card mb-3 border-0 bg-white">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="fw-bold mb-1">@(review.AppUser?.FullName ?? "Аноним")</h6>
                                                    <small class="text-muted">@review.ReviewCreatedAt.ToString("dd MMMM yyyy")</small>
                                                </div>
                                                <div class="text-warning">
                                                    @{
                                                        for (int i = 1; i <= review.Score; i++)
                                                        {
                                                            <i class="fi fi-star-full"></i>
                                                        }

                                                        for (int i = 1; i <= 5 - review.Score; i++)
                                                        {
                                                            <i class="fi fi-star-empty"></i>
                                                        }
                                                    }
                                                    <span class="ms-2 text-muted">@review.Score.ToString("F1")</span>
                                                </div>
                                            </div>
                                            <p class="card-text mb-0">@review.Comment</p>
                                            @if (user != null && review.AppUser?.IdUser == user.Id)
                                            {
                                                <div class="mt-2 text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-pill" onclick="deleteReview('@review.IdReview')">
                                                        <i class="fi fi-thrash"></i> Удалить
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <h5 class="fw-bold">Пока нет отзывов</h5>
                                 <p class="text-muted">Будьте первым, кто оставит отзыв об этом объекте</p>                              
                            </div>
                            
                        }

                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <div class="text-center py-5">
                                <p class="text-muted">Войдите в аккаунт, чтобы поделиться своим мнением</p>
                                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-pill">
                                    Войти
                                </a>
                            </div>
                        }
                        <!-- Форма добавления отзыва -->
                        @if (SignInManager.IsSignedIn(User) && !hasUserReviewed)
                        {
                            <form asp-controller="Object" asp-action="AddReview" method="post" id="reviewForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ObjectId" value="@obj?.IdObject" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Ваша оценка <span class="text-danger">*</span></label>
                                    <div class="text-warning rating-stars d-flex">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="star-rating fi fi-star-empty" data-rating="@i" style="font-size: 2rem; cursor: pointer; margin-right: 4px;"></i>
                                        }
                                    </div>
                                    <input type="hidden" name="Score" id="selectedScore" value="@Model.AddReview?.Score" />
                                    @if (ViewData.ModelState["Score"]?.Errors?.Any() == true)
                                    {
                                        <span class="text-danger d-block mt-2 small">@ViewData.ModelState["Score"].Errors[0].ErrorMessage</span>
                                    }
                                </div>

                                <div class="mb-3">
                                    <label for="Comment" class="form-label fw-bold">
                                        Комментарий <span class="text-danger">*</span>
                                    </label>
                                    <div class="form-floating">
                                        <textarea name="Comment"
                                              id="Comment"
                                              class="form-control @(ViewData.ModelState["Comment"]?.Errors?.Any())"
                                              placeholder="Поделитесь своим опытом..."
                                              style="height: 120px;"
                                              maxlength="1000"
                                              data-counter="commentCounter">@Model.AddReview?.Comment</textarea>
                                        <label for="Comment">Комментарий</label>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        @if (ViewData.ModelState["Comment"]?.Errors?.Any() == true)
                                        {
                                            <span class="text-danger small">@ViewData.ModelState["Comment"].Errors[0].ErrorMessage</span>
                                        }
                                        <span class="small text-muted ms-auto"><span id="commentCounter">@(Model.AddReview?.Comment?.Length ?? 0)</span>/1000</span>
                                    </div>
                                </div>

                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary btn-pill">
                                        Отправить отзыв
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <!-- Правая колонка -->
            <div class="col-lg-4">
                <!-- Рейтинг -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4 text-center">
                        <h3 class="display-1 fw-bold text-primary mb-2">@obj?.ScoreObject.ToString("F1")</h3>
                        <div class="text-warning fs-3">
                            @{
                                decimal score = obj?.ScoreObject ?? 0;
                                int fullStar = (int)Math.Floor(score);
                                bool halfStar = (score - fullStar) >= 0.5m;

                                for (int i = 0; i < fullStar; i++)
                                {
                                    <i class="fi fi-star-full"></i>
                                }

                                if (halfStar)
                                {
                                    <i class="fi fi-start-half"></i>
                                }

                                int emptyStar = 5 - fullStar - (halfStar ? 1 : 0);
                                for (int i = 0; i < emptyStar; i++)
                                {
                                    <i class="fi fi-star-empty"></i>
                                }
                            }
                        </div>
                        <p class="text-muted mb-0">Общая оценка на основе @Model.Reviews.Count 
                            @if (Model.Reviews.Count == 1)
                            {
                                @:отзыва
                            }
                            else 
                            {
                                @:отзывов
                            }
                        </p>
                    </div>
                </div>

                <!-- Местоположение -->
                @if (!string.IsNullOrEmpty(obj?.Address))
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">
                                <i class="fi fi-map text-primary me-2"></i>Местоположение
                            </h5>                           
                            <p class="mb-2">
                               @obj.Address
                            </p>
                            <div id="map" style="height: 300px; width: 100%; border-radius: 0 0 8px 8px;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для удаления отзыва -->
<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-labelledby="deleteReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteReviewModalLabel">Удаление отзыва</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-3">
                    <i class="fi fi-thrash fs-1 text-danger"></i>
                    <p class="mb-0">Вы действительно хотите удалить этот отзыв?</p>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-pill" data-bs-dismiss="modal">
                    Отмена
                </button>
                <form id="deleteReviewForm" asp-controller="Object" asp-action="DeleteReview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteReviewId" value="" />
                    <input type="hidden" name="objectId" id="deleteObjectId" value="@obj?.IdObject" />
                    <button type="submit" class="btn btn-danger btn-pill">
                        Удалить
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://api-maps.yandex.ru/2.1/?apikey=@Configuration["YandexMaps:ApiKey"]&lang=ru_RU"></script>
    <script>
        let map;
        let placemark;

        @{
            var hasCoordinates = obj?.Location != null;

            string lat = "59.9343";
            string lng = "30.3351";
            int zoom = 12;

            if (hasCoordinates)
            {
                 try
                 {
                     lat = obj.Location.Y.ToString(System.Globalization.CultureInfo.InvariantCulture);
                     lng = obj.Location.X.ToString(System.Globalization.CultureInfo.InvariantCulture);
                     zoom = 17;
                 }
                 catch
                 {
                     hasCoordinates = false;
                 }
            }
        }

        // Инициализация карты
        function initMap()
        {
            const defaultCenter = [parseFloat(@lat), parseFloat(@lng)];

            map = new ymaps.Map('map', {
                center: defaultCenter,
                zoom: @zoom,
                controls: ['zoomControl', 'fullscreenControl']
            });

            @if (hasCoordinates)
            {
            <text>
                const coords = [parseFloat(@lat), parseFloat(@lng)];

                placemark = new ymaps.Placemark(coords, {}, {
                    preset: 'islands#redDotIcon',
                    draggable: true
                });
                map.geoObjects.add(placemark);
                </text>
            }
        }

        $(document).ready(function() {
            // Инициализация карты
            ymaps.ready(initMap);

            // Инициализация счетчиков символов
            initCharacterCounters();

            // Звезды рейтинга
            const stars = $('.star-rating');
            const selectedScore = $('#selectedScore');

            // Функция обновления звезд на основе рейтинга
            function updateStars(rating) {
                stars.each(function(index) {
                    const starRating = $(this).data('rating');
                    if (starRating <= rating) {
                        $(this).removeClass('fi-star-empty').addClass('fi-star-full active');
                    } else {
                        $(this).removeClass('fi-star-full active').addClass('fi-star-empty');
                    }
                });
            }

            // Обработчик клика на звезду
            stars.on('click', function() {
                const rating = $(this).data('rating');
                selectedScore.val(rating);
                updateStars(rating);
            });

            // Инициализация при загрузке (если была ошибка валидации)
            const savedScore = selectedScore.val();
            if (savedScore > 0) {
                updateStars(savedScore);
            }
        });

        // Функция инициализации счетчиков символов
        function initCharacterCounters() {
            const inputs = document.querySelectorAll('[data-counter]');

            inputs.forEach(input => {
                const counterId = input.getAttribute('data-counter');
                updateCharacterCounter(input.id, counterId);

                input.addEventListener('input', function() {
                    updateCharacterCounter(this.id, counterId);
                });

                input.addEventListener('keyup', function() {
                    updateCharacterCounter(this.id, counterId);
                });
            });
        }

        // Функция обновления счетчика символов
        function updateCharacterCounter(inputId, counterId) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);

            if (input && counter) {
                const currentLength = input.value.length;
                counter.textContent = currentLength;               
            }
        }

        function deleteReview(reviewId) {
            $('#deleteReviewId').val(reviewId);
            $('#deleteReviewModal').modal('show');
        }
    </script>
}