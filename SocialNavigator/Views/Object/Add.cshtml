@{
    ViewData["Title"] = "Добавление нового объекта";
}
<div class="container py-5">
    <!-- Заголовок -->
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-5 fw-bold mb-4">Добавление нового объекта</h1>
            <p class="lead mb-0">Заполните информацию об объекте.</p>
        </div>
    </div>

    <!-- Шаги -->
    <div class="row mb-4">
        <div class="col-lg-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-center flex-grow-1">
                    <div id="step1-indicator" class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px;">1</div>
                    <div class="small">Основная информация</div>
                </div>
                <div class="flex-grow-1">
                    <hr class="my-0">
                </div>
                <div class="text-center flex-grow-1">
                    <div id="step2-indicator" class="bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px;">2</div>
                    <div class="small text-muted">Доступность</div>
                </div>
                <div class="flex-grow-1">
                    <hr class="my-0">
                </div>
                <div class="text-center flex-grow-1">
                    <div id="step3-indicator" class="bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px;">3</div>
                    <div class="small text-muted">Подтверждение</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Форма -->
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-lg border-0">
                <div class="card-body p-4">
                    <form id="addObjectForm" method="post" action="/object/add">
                        @Html.AntiForgeryToken()

                        <!-- Шаг 1: Основная информация -->
                        <div id="step1">
                            <h2 class="fw-bold mb-4">Основная информация</h2>

                            <div class="mb-4">
                                <label for="objectName" class="form-label fw-bold">
                                    Название объекта <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="objectName"
                                       name="Name"
                                       placeholder="Введите название объекта"
                                       maxlength="200"
                                       required>
                                <div class="form-text text-end"><span id="nameCounter">0</span>/200</div>
                            </div>

                            <div class="mb-4">
                                <label for="objectDescription" class="form-label fw-bold">Описание</label>
                                <textarea class="form-control"
                                          id="objectDescription"
                                          name="Description"
                                          rows="4"
                                          placeholder="Опишите объект..."
                                          maxlength="2000"></textarea>
                                <div class="form-text text-end"><span id="descCounter">0</span>/2000</div>
                            </div>

                            <hr class="my-4">

                            <h4 class="fw-bold mb-4">Расположение</h4>

                            <div class="mb-4">
                                <label for="objectAddress" class="form-label fw-bold">
                                    Адрес <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="objectAddress"
                                       name="Address"
                                       placeholder="Введите полный адрес"
                                       maxlength="500"
                                       required>
                                <div class="form-text text-end"><span id="addressCounter">0</span>/500</div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label for="objectLatitude" class="form-label fw-bold">Широта</label>
                                    <input type="number"
                                           class="form-control"
                                           id="objectLatitude"
                                           name="Latitude"
                                           placeholder="от -90 до 90"
                                           step="0.000001"
                                           min="-90"
                                           max="90">
                                    <div class="form-text">Координаты будут определены автоматически</div>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label for="objectLongitude" class="form-label fw-bold">Долгота</label>
                                    <input type="number"
                                           class="form-control"
                                           id="objectLongitude"
                                           name="Longitude"
                                           placeholder="от -180 до 180"
                                           step="0.000001"
                                           min="-180"
                                           max="180">
                                    <div class="form-text">Или укажите вручную</div>
                                </div>
                            </div>

                            <hr class="my-4">

                            <h4 class="fw-bold mb-4">Категория</h4>

                            <div class="mb-4">
                                <label for="objectType" class="form-label fw-bold">
                                    Тип объекта <span class="text-danger">*</span>
                                </label>
                                <select class="form-select form-select-lg" id="objectType" name="ObjectTypeId" required>
                                    <option value="">Выберите тип объекта</option>
                                    <option value="mediko_socialnaya_ekspertiza">Медико-социальная экспертиза</option>
                                    <option value="socialnaya_zaschita_naseleniya">Социальная защита населения</option>
                                    <option value="zdravoohranenie">Здравоохранение</option>
                                    <option value="obrazovanie">Образование</option>
                                    <option value="inklyuzivny_detskiy_otdyh">Инклюзивный детский отдых</option>
                                    <option value="kultura">Культура</option>
                                    <option value="fizicheskaya_kultura_i_sport">Физическая культура и спорт</option>
                                    <option value="sfr">СФР</option>
                                    <option value="pfr">ПФР</option>
                                    <option value="fss">ФСС</option>
                                    <option value="nalogovaya_sluzhba">Налоговая служба</option>
                                    <option value="svyaz_i_informaciya">Связь и информация</option>
                                    <option value="zhilye_zdaniya_i_pomescheniya">Жилые здания и помещения</option>
                                    <option value="potrebitelskiy_rynok_i_sfera_uslug">Потребительский рынок и сфера услуг</option>
                                    <option value="mesta_prilozheniya_truda">Места приложения труда</option>
                                    <option value="dorozhno_transportnye">Дорожно-транспортные</option>
                                    <option value="administrativnye_organizacii_i_uchrezhdeniya">Административные организации и учреждения</option>
                                    <option value="molodezhnaya_politika">Молодежная политика</option>
                                </select>
                            </div>
                        </div>

                        <!-- Шаг 2: Доступность -->
                        <div id="step2" class="d-none">
                            <h2 class="fw-bold mb-4">Критерии доступности</h2>
                            <p class="text-muted mb-4">Отметьте, для каких категорий маломобильности доступен объект</p>

                            <div class="mb-3">
                                <div class="form-check form-switch form-check-lg mb-3">
                                    <input class="form-check-input" type="checkbox" id="wheelchairs" name="Wheelchairs" value="true">
                                    <label class="form-check-label fw-bold" for="wheelchairs">
                                        Для людей, передвигающихся на креслах-колясках
                                    </label>
                                </div>

                                <div class="form-check form-switch form-check-lg mb-3">
                                    <input class="form-check-input" type="checkbox" id="blindAccess" name="BlindAccess" value="true">
                                    <label class="form-check-label fw-bold" for="blindAccess">
                                        Для людей с нарушениями зрения
                                    </label>
                                </div>

                                <div class="form-check form-switch form-check-lg mb-3">
                                    <input class="form-check-input" type="checkbox" id="deafAccess" name="DeafAccess" value="true">
                                    <label class="form-check-label fw-bold" for="deafAccess">
                                        Для людей с нарушениями слуха
                                    </label>
                                </div>

                                <div class="form-check form-switch form-check-lg mb-3">
                                    <input class="form-check-input" type="checkbox" id="speechAccess" name="SpeechAccess" value="true">
                                    <label class="form-check-label fw-bold" for="speechAccess">
                                        Для людей с нарушениями речи
                                    </label>
                                </div>

                                <div class="form-check form-switch form-check-lg mb-3">
                                    <input class="form-check-input" type="checkbox" id="mobilityAccess" name="MobilityAccess" value="true">
                                    <label class="form-check-label fw-bold" for="mobilityAccess">
                                        Для людей с нарушениями опорно-двигательного аппарата
                                    </label>
                                </div>

                                <div class="form-check form-switch form-check-lg mb-3">
                                    <input class="form-check-input" type="checkbox" id="intellectualAccess" name="IntellectualAccess" value="true">
                                    <label class="form-check-label fw-bold" for="intellectualAccess">
                                        Для людей с умственными нарушениями
                                    </label>
                                </div>

                                <div class="form-check form-switch form-check-lg mb-3">
                                    <input class="form-check-input" type="checkbox" id="autismAccess" name="AutismAccess" value="true">
                                    <label class="form-check-label fw-bold" for="autismAccess">
                                        Для людей с нарушениями поведения и общения
                                    </label>
                                </div>
                            </div>

                            <div class="alert alert-info mt-4">
                                <i class="fi fi-info-circle me-2"></i>
                                Отметьте только те категории, для которых объект действительно доступен.
                                Если вы не уверены, оставьте поле неотмеченным.
                            </div>
                        </div>

                        <!-- Шаг 3: Подтверждение -->
                        <div id="step3" class="d-none">
                            <h2 class="fw-bold mb-4">Проверьте информацию</h2>

                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <h5 class="fw-bold mb-3">Основная информация</h5>

                                    <div class="mb-3">
                                        <label class="form-label text-muted small mb-1">Название:</label>
                                        <div id="review-name" class="fw-bold fs-5"></div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-muted small mb-1">Адрес:</label>
                                        <div id="review-address" class="fw-bold"></div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-muted small mb-1">Координаты:</label>
                                        <div id="review-coordinates" class="fw-bold"></div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-muted small mb-1">Тип объекта:</label>
                                        <div id="review-type" class="fw-bold"></div>
                                    </div>

                                    <hr class="my-4">

                                    <h5 class="fw-bold mb-3">Критерии доступности</h5>
                                    <div id="review-accessibility" class="d-flex flex-wrap gap-2">
                                        <!-- Сюда критерии -->
                                    </div>

                                    
                                </div>
                            </div>
                        </div>

                        <!-- Кнопки -->
                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" id="btnCancel" class="btn btn-outline-secondary btn-lg px-5">
                                Отмена
                            </button>
                            <div>
                                <button type="button" id="btnPrev" class="btn btn-outline-primary btn-lg px-4 d-none">
                                    Назад
                                </button>
                                <button type="button" id="btnNext" class="btn btn-primary btn-lg px-5 ms-2">
                                    Далее
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
