@model Domain.DTO.LoginDto
@{
    ViewData["Title"] = "Вход";
}

<div class="d-lg-flex text-white min-vh-100" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="col-12 col-lg-5 d-lg-flex">
        <div class="w-100 align-self-center">
            <div class="py-7 px-5">
                <h1 class="d-inline-block text-align-end text-center-md text-center-xs display-4 w-100 max-w-600">
                    Вход
                    <span class="display-3 d-block fw-medium">
                        Социальный навигатор
                    </span>
                </h1>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7 d-lg-flex">
        <div class="w-100 align-self-center text-center-md text-center-xs p-2">
            <<form asp-controller="Account" asp-action="Login" method="post" class="bs-validate p-5 py-6 rounded d-inline-block bg-white text-dark w-100 max-w-600" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                
                <div class="form-floating mb-3">
                    <input asp-for="UserName" class="form-control" placeholder="Логин" />
                    <label asp-for="UserName">Логин</label>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="input-group-over">
                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Пароль" />
                        <label asp-for="Password">Пароль</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <a asp-controller="Account" asp-action="ForgotPassword" class="btn smaller fw-bold">
                        Забыли пароль?
                    </a>
                </div>

                <div class="row">
                    <div class="col-12 col-md-6 mt-4">
                        <button type="submit" class="btn btn-primary btn-pill w-100 transition-hover-top">
                            Войти
                        </button>
                    </div>

                    <div class="col-12 col-md-6 mt-3 text-align-end text-center-xs">
                        <a asp-controller="Account" asp-action="Register" class="btn px-0 link-normal transition-hover-top">
                            Нет аккаунта? Зарегистрируйтесь
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

