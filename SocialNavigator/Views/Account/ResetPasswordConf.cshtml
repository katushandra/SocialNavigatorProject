@{
    ViewData["Title"] = "Пароль изменен";
}

<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="bg-white p-5 rounded shadow text-center">
                    <div class="mb-4">
                        <i class="fi fi-shield-ok fs-1 text-primary"></i>
                    </div>

                    <h1 class="fw-bold mb-4">Новый пароль установлен</h1>

                    <div class="alert alert-success mb-4 p-4">
                        <p class="lead mb-0">
                            Пароль успешно изменен. Теперь вы можете войти с новым паролем.
                        </p>
                    </div>

                    <div class="text-center">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-pill transition-hover-top">
                            Перейти ко входу
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>