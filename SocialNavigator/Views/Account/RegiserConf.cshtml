@{
    ViewData["Title"] = "Подтверждение email";
}

<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="bg-white p-5 rounded shadow text-center">

                    <div class="display-1 text-primary mb-4">
                        <i class="fi-envelope-2" style="font-size: 5rem;"></i>
                    </div>

                    <h1 class="fw-bold mb-4">Подтвердите ваш email</h1>

                    <div class="alert alert-info mb-4 p-4">
                        <p class="lead mb-0">
                            На адрес <strong>@ViewBag.Email</strong> отправлено письмо с ссылкой для подтверждения.
                        </p>
                    </div>

                    <div class="mb-5">
                        <ol class="text-start list-group-numbered d-inline-block">
                            <li class="mb-2">Проверьте вашу электронную почту</li>
                            <li class="mb-2">Перейдите по ссылке в письме</li>
                            <li class="mb-2">После подтверждения email войдите в систему</li>
                        </ol>
                    </div>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-pill scroll-to mx-2">
                        Перейти к входу
                    </a>
                    
                </div>
            </div>
        </div>
    </div>
</div>
