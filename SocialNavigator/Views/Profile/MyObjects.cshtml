@using Domain.Entity.Enums
@model IEnumerable<Domain.DTO.MyObjectDto>
@{
    ViewData["Title"] = "Мои объекты";
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int>;
    var totalCount = statusCounts?.Sum(x => x.Value) ?? 0;
}

<!-- Блок: обложка -->
<div class="section jarallax" style="background-image:url('/frontend/assets/images/background.png')">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-4">Мои объекты</h1>
                <p class="lead mb-0">Объекты, добавленные вами на карту</p>
            </div>
        </div>
    </div>
</div>

<!-- Блок: объекты -->
<div class="section bg-light">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                 @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Навигация по статусам -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <ul class="nav nav-lg nav-invert">
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == null || ViewBag.CurrentStatus == "all" ? "active" : "")"
                       asp-action="MyObjects" asp-route-status="all">
                        Все <span class="badge bg-secondary ms-2">@totalCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == "Pending" ? "active" : "")"
                       asp-action="MyObjects" asp-route-status="Pending">
                        На модерации <span class="badge bg-warning ms-2">@(statusCounts != null && statusCounts.ContainsKey("Pending") ? statusCounts["Pending"] : 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == "Approved" ? "active" : "")"
                       asp-action="MyObjects" asp-route-status="Approved">
                        Одобренные <span class="badge bg-success ms-2">@(statusCounts != null && statusCounts.ContainsKey("Approved") ? statusCounts["Approved"] : 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == "Rejected" ? "active" : "")"
                       asp-action="MyObjects" asp-route-status="Rejected">
                        Отклоненные <span class="badge bg-danger ms-2">@(statusCounts != null && statusCounts.ContainsKey("Rejected") ? statusCounts["Rejected"] : 0)</span>
                    </a>
                </li>
            </ul>

            <a asp-controller="Object" asp-action="Add" class="btn btn-primary btn-pill">
                <i class="fi fi-plus me-2"></i>Добавить объект
            </a>
        </div>

        <!-- Список объектов -->
        <div id="objects-container" class="row">
            <div class="col-12">

                @if (Model != null && Model.Any())
                {
                    @foreach (var obj in Model)
                    {
                        <div class="card mb-3">
                            <div class="card-body d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-2">@obj.Name</h5>
                                    <p class="card-text text-muted mb-0">
                                        <span class="badge rounded-pill bg-primary text-white px-5 mb-2">
                                            @obj?.ObjectType?.NameObjectType
                                        </span>

                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @if (obj.Status == Status.Pending)
                                            {
                                                <span class="badge rounded-pill bg-warning">На модерации</span>
                                            }
                                            @if (obj.Status == Status.Approved)
                                            {
                                                <span class="badge rounded-pill bg-success">Одобрен</span>
                                            }
                                            @if (obj.Status == Status.Rejected)
                                            {
                                                <span class="badge rounded-pill bg-danger">Отклонен</span>
                                            }
                                            @if (obj.Status == Status.Archived)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark">В архиве</span>
                                            }
                                        </div>
                                        <i class="fi fi-pin-2"></i> @obj.Address<br>
                                        <i class="fi fi-calendar"></i> @obj.CreatedAt.ToString("dd.MM.yyyy")<br>
                                    </p>
                                </div>

                                <div class="d-flex gap-2 ms-4 align-items-center">
                                    @if (obj.Status == Status.Approved)
                                    {
                                        <a asp-controller="Object" asp-action="Full" asp-route-id="@obj.IdObject" class="btn btn-sm btn-outline-primary btn-pill">
                                            Посмотреть
                                        </a>
                                    }

                                    @if (obj.Status == Status.Rejected)
                                    {
                                        <a asp-controller="Object" asp-action="Edit" asp-route-id="@obj.IdObject"
                                           class="btn btn-sm btn-outline-warning btn-pill">
                                            <i class="fi fi-pencil me-1"></i>Редактировать
                                        </a>
                                    }

                                    @if (obj.Status == Status.Pending)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-pill"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@obj.IdObject">
                                            <i class="fi fi-thrash me-1"></i> Удалить
                                        </button>
                                    }                                    
                                </div>
                            </div>
                        </div>

                        <!-- Модальное окно для удаления -->
                        <div class="modal fade" id="deleteModal-@obj.IdObject" data-bs-keyboard="false" tabindex="-1" aria-labelledby="archiveModalLabel-@obj.IdObject" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel-@obj.IdObject">
                                            Удаление объекта
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="text-center py-3">
                                            <i class="fi fi-thrash fs-1 text-danger"></i>
                                            <p class="mb-0">Вы действительно хотите удалить объект</p>
                                            <p class="fw-bold">"@obj.Name"</p>
                                            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert"> 
                                                После удаления восстановить объект не получится.
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer d-flex justify-content-between">
                                        <button type="button" class="btn btn-outline-secondary btn-pill" data-bs-dismiss="modal">
                                            Отмена
                                        </button>
                                        <form asp-controller="Object" asp-action="Delete" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@obj.IdObject" />
                                            <button type="submit" class="btn btn-danger btn-pill">
                                                Удалить
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Отсутствие объектов -->
                    <div class="row">
                        <div class="col-12 mx-auto">
                            <div class="card border-0 shadow-sm text-center py-5">
                                <div class="card-body">
                                    <h3 class="fw-bold mb-3">
                                        @if (ViewBag.CurrentStatus != null && ViewBag.CurrentStatus != "all")
                                        {
                                            <span>
                                                Нет объектов со статусом 
                                                @switch (ViewBag.CurrentStatus)
                                                {
                                                    case "Pending":
                                                        <span class="badge rounded-pill bg-warning">На модерации</span>
                                                        break;
                                                    case "Approved":
                                                        <span class="badge rounded-pill bg-success">Одобрен</span>
                                                        break;
                                                    case "Rejected":
                                                        <span class="badge rounded-pill bg-danger">Отклонен</span>
                                                        break;
                                                    case "Archived":
                                                        <span class="badge rounded-pill bg-light text-dark">Заархивирован</span>
                                                        break;
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span>У вас пока нет объектов</span>
                                        }
                                    </h3>
                                    <p class="text-muted mb-4">
                                        Добавьте новый объект на карту
                                    </p>
                                    <a asp-controller="Object" asp-action="Add" class="btn btn-primary btn-pill">
                                        <i class="fi fi-plus me-2"></i>Добавить объект
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>