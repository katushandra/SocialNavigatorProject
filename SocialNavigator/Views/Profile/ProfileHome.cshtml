@model Domain.DTO.AppUserDto
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                        <i class="fi fi-user-male fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-1">@(Model.FullName ?? Model.UserName)</h4>

                    @if (Model.Role == "User")
                    {
                        <span class="badge rounded-pill bg-info">Пользователь</span>
                    }
                                                
                    @if (Model.Role == "Moderator")
                    {
                        <span class="badge rounded-pill bg-warning">Модератор</span>
                    }
                                                
                    @if (Model.Role == "Admin")
                    {
                         <span class="badge rounded-pill bg-danger ">Администратор</span>
                    }

                    <div class="d-grid gap-2 mt-4">                 
                        @if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
                        {
                            <a asp-controller="Moderator" asp-action="ModeratorPanel">
                                <button type="submit" class="btn btn-outline-warning btn-pill scroll-to w-100">
                                    Панель модератора
                                </button>
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="AdminPanel">
                                <button type="submit"class="btn btn-outline-danger btn-pill scroll-to w-100">
                                    Панель администратора
                                 </button>
                            </a>
                        }                    
                               
                        <a asp-controller="Profile" asp-action="ChangePassword">
                            <button type="submit" class="btn btn-outline-primary btn-pill scroll-to w-100">
                                Сменить пароль
                            </button>
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-pill scroll-to w-100">
                                Выйти
                            </button>
                        </form>                        
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div id="profile-info" class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">
                        <i class="fi fi-user me-2"></i>Ваши данные
                    </h5>
                </div>
                <div class="card-body p-4">                                    

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["InfoMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            @TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <form asp-controller="Profile" asp-action="UpdateProfile" method="post" class="needs-validation">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="IdUser" />
                        <input type="hidden" asp-for="UserCreatedAt" />
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" asp-for="Role" />

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.UserCreatedAt, new { @class = "form-control", placeholder = "Дата регистрации", @readonly = "readonly", disabled = "disabled" })
                            @Html.LabelFor(m => m.UserCreatedAt, "Дата регистрации")
                        </div>

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "ФИО" })
                            @Html.LabelFor(m => m.FullName, "ФИО")
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Логин", @readonly = "readonly", disabled = "disabled" })
                            @Html.LabelFor(m => m.UserName, "Логин")
                            <small class="text-muted">Логин нельзя изменить</small>
                        </div>

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email", type = "email" })
                            @Html.LabelFor(m => m.Email, "Email")
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary btn-pill">
                                Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>